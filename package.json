{
  "name": "crypto-multi-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Crypto Multi-Tool - Unified Node.js Application for Hostinger",
  "main": "server.js",
  "scripts": {
    "dev": "vite",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/server/router.ts --outDir dist/server --emptyOutDir false",
    "build": "tsc --noEmit && vite build && vite build --ssr src/server/router.ts --outDir dist/server --emptyOutDir false",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "lightweight-charts": "^4.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "keywords": [
    "crypto",
    "trading",
    "radar",
    "hostinger",
    "nodejs"
  ],
  "author": "Global Solutions UY",
  "license": "UNLICENSED"
}
