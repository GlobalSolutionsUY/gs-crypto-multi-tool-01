# ==============================================================================
# Crypto Multi-Tool (Radar & Copilot) - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Binance Market Data (Read-Only API)
# Optional in development (falls back to unauthenticated public endpoints)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com

# Telegram Dispatcher (Push Notifications to Operators)
# Required for mobile alert delivery (Ger & Freya)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Network Ports
BACKEND_PORT=8000
MCP_SERVER_PORT=8001
WEB_PORT=3000

# Storage Paths (Local Development defaults; VPS uses /var/crypto-tool/...)
LOGS_DIR=./logs
ARTIFACTS_DIR=./artifacts

# Hostinger VPS Host & Deployment Settings (Used in deployment phases)
HOSTINGER_HOST=your_server_hostname_or_ip
HOSTINGER_USER=u987218503
HOSTINGER_SSH_KEY=
